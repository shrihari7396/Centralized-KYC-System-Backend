graph TD
    Client[Client Web/Mobile App]
    Kafka[Kafka Distributed Log]
    DB[(PostgreSQL)]
    Redis[(Redis Cluster)]

    subgraph Notification Services Collection
        NS1[Notification Service - Instance A]
        NS2[Notification Service - Instance B]
    end

    Client -- "1. WS Connect (incl. JWT)" --> NS1
    NS1 -- "2. Store routing mapping:\nuser:{userId} -> instanceA" --> Redis
    
    Kafka -- "3. Consume Event" --> NS2
    NS2 -- "4. Save immediately as PENDING" --> DB
    NS2 -- "5. Lookup user:{userId} location" --> Redis
    NS2 -- "6. Publish precisely to:\nnotify:instanceA" --> Redis
    
    Redis -- "7. Pub/Sub routing" --> NS1
    NS1 -- "8. Securely Push to Socket" --> Client
    NS1 -- "9. Atomic Claim\nUpdate status -> DELIVERED" --> DB
