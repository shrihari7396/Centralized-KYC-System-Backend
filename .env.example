# ==============================================================================
# Centralized KYC System - Environment Variables Configuration Template
# COPY THIS FILE TO .env AND POPULATE WITH SECURE, ENVIRONMENT-SPECIFIC VALUES
# DO NOT COMMIT REAL PRODUCTION CREDENTIALS OR KEYS TO VERSION CONTROL
# ==============================================================================

# --- Service Discovery (Netflix Eureka) ---
EUREKA_SERVER_URL=http://localhost:8761/eureka
EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://localhost:8761/eureka/
EUREKA_INSTANCE_PREFER_IP_ADDRESS=true

# --- Relational Database (MySQL 8.0) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=kyc_user
MYSQL_PASSWORD=change_me_secure_mysql_password_here
MYSQL_ROOT_PASSWORD=change_me_secure_root_password_here

# Individual Database Names
MYSQL_DATABASE_USERS=users
MYSQL_DATABASE_KYC=kyc
MYSQL_DATABASE_CONSENT=kyc_consent_db
MYSQL_DATABASE_NOTIFICATION=kyc_notification_db

# --- Document Database (MongoDB 7.0) ---
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DATABASE=kyc_db
MONGODB_USERNAME=kyc_mongo_user
MONGODB_PASSWORD=change_me_secure_mongo_password_here

# --- Caching & Session Store (Redis 7.x) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Messaging & Event Streaming (Apache Kafka) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# For Production with SASL/TLS:
# KAFKA_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_SASL_MECHANISM=SCRAM-SHA-512
# KAFKA_SASL_JAAS_CONFIG=org.apache.kafka.common.security.scram.ScramLoginModule required username="app" password="password";

# --- Security & Cryptographic Keys (AES-256 & JWT HS256) ---
# Generate using: openssl rand -hex 32
JWT_SECRET=change_me_generate_random_64_hex_character_key_for_jwt_auth_12345
JWT_EXPIRATION_MS=3600000

# Distinct symmetric AES-256 key for database field-level encryption (64 hex characters)
ENCRYPTION_SECRET_KEY=change_me_generate_random_64_hex_character_key_for_aes_enc_67890

# Gateway HMAC Signature Key
APIGATEWAY_SECURITY_SECRET_KEY=change_me_generate_random_gateway_hmac_secret_key_abcdef

# --- Third-Party / External Integrations ---
# Groq Cloud AI API
GROQ_API_KEY=gsk_placeholder_replace_with_actual_api_key
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_API_MODEL=llama-3.3-70b-versatile

# Transactional Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_AUTH=true
SMTP_STARTTLS_ENABLE=true
SMTP_USERNAME=no-reply@kyc-system.com
SMTP_PASSWORD=change_me_smtp_app_password
SMTP_FROM=no-reply@kyc-system.com

# Frontend Application Consent Base URL
APP_CONSENT_URL=http://localhost:3000/consent
